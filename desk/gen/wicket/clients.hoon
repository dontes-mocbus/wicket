::  +wicket/clients: list OAuth clients
::
/-  *wicket
/+  wicket-dojo
:-  %say
|=  $:  [now=@da eny=@uvJ bec=beak]
        ~
        ~
    ==
=/  run
  %-  mule
  |.  .^((list client) %gx /(scot %p p.bec)/wicket/(scot %da now)/clients/noun)
:-  %txt
?:  ?=(%| -.run)
  ['%wicket is not running']~
(lines:wicket-dojo (clients-text:wicket-dojo p.run))
